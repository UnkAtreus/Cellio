# The working directory also holds private QA history. Publish root entries explicitly.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/Package.swift
!/Sources/
!/Tests/
!/Resources/
!/DesignAssets/
!/Vendor/
!/TestTools/
!/scripts/
!/docs/
!/.github/

# Only curated public documentation and build tools belong in this repository.
/docs/*
!/docs/building.md
!/docs/device-support.md
!/docs/request-device-support.md
!/docs/signing.md
!/docs/ux-ui.md
/scripts/*
!/scripts/build-macos.sh
!/scripts/local-signing.py
!/scripts/package-sparkle.py
!/scripts/release-tool.py
!/scripts/release-crypto.swift
/TestTools/*
!/TestTools/sign_update
!/TestTools/receipt.json

.DS_Store
__pycache__/
*.pyc
*.p12
*.pfx
*.keychain*
.env
.env.*

# Historical receipt-bound QA remains local; publish standalone regressions.
/Tests/*
!/Tests/PortableCoreTests/
!/Tests/PermissionsNavigation/
/Tests/PermissionsNavigation/results.json
/Tests/PermissionsNavigation/frozen-hashes.json
!/docs/images/
!/docs/validation.md
